MQTT_HOST=192.168.1.4
MQTT_PORT=1883
MQTT_USERNAME=saems_server
MQTT_PASSWORD=replace-with-server-password
PUMP_COMMAND_MAX_SECONDS=60
API_BIND_HOST=127.0.0.1
API_PORT=3000
API_PUBLIC_MODE=false
# Required when API_PUBLIC_MODE=true: generate with python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ACCESS_TOKEN=
# App/dashboard login. Set both with: .venv/bin/python auth.py set-password
SAEMS_ADMIN_USER=admin
SAEMS_ADMIN_PASSWORD_HASH=
SAEMS_SESSION_TTL_HOURS=720
CORS_ORIGINS=
MQTT_TLS=false
MQTT_CA_FILE=
# Telegram alerts (optional). Create a bot with @BotFather, send it one
# message, then read chat.id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids
TELEGRAM_CHAT_ID=
